# Polymarket Bot Configuration
# Copy to .env and adjust values

# Arbitrage thresholds
MIN_PROFIT_PCT=0.5
MAX_PRICE_SUM=0.995
MIN_LIQUIDITY=1000
MIN_VOLUME_24H=500

# Signal settings
MIN_CONFIDENCE=0.6
SCAN_INTERVAL_SEC=30
MAX_MARKETS_PER_SCAN=500

# Trading (optional)
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_FUNDER_ADDRESS=
MAX_BET_SIZE_USD=50
AUTO_TRADE=false
